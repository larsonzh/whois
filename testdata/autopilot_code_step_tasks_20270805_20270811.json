    "D1": {
      "type": "regex-patch",
      "description": "Declare and implement wc_net_info transport ownership helpers.",
      "idempotentContainsByTarget": {
        "net_header": [
          "wc_transport_t* custom_transport;",
          "wc_transport_t* wc_net_info_get(struct wc_net_info* info, wc_transport_t* bare_transport);"
